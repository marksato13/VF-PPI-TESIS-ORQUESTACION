[Unit]
Description=CyberFlow - publicar el feed cada 10 segundos

[Timer]
# OnCalendar (no OnUnitActiveSec): este ultimo se quedaba con NextElapse=infinity.
# Primer paso de la cadena escalonada: publicar :00, relay :03, agente :06.
OnCalendar=*-*-* *:*:00/10
AccuracySec=1s
Persistent=false

[Install]
WantedBy=timers.target
