#!/usr/bin/env python3
"""Escaneo de secretos antes de publicar.

Uso:
    ppi-secrets            revisa lo que git va a subir (staged + working tree)
    ppi-secrets --todo     revisa el arbol completo, incluido el historial de trabajo
    ppi-secrets --hook     se instala como pre-commit

Sale != 0 si encuentra algo. Pensado para ser un gate, no un aviso.
Solo biblioteca estandar.
"""
from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

# Cada regla: (nombre, patron, severidad). ALTA bloquea; MEDIA avisa.
REGLAS = [
    ("clave privada", re.compile(rb"-----BEGIN [A-Z ]*PRIVATE KEY-----"), "ALTA"),
    ("token de GitHub", re.compile(rb"\bgh[pousr]_[A-Za-z0-9]{30,}"), "ALTA"),
    ("clave de AWS", re.compile(rb"\bAKIA[0-9A-Z]{16}\b"), "ALTA"),
    ("clave de OpenAI/Anthropic", re.compile(rb"\b(?:sk-ant-|sk-)[A-Za-z0-9_\-]{24,}"), "ALTA"),
    ("credencial del laboratorio", re.compile(rb"\bcisco123\b"), "ALTA"),
    ("contrasena asignada en claro",
     re.compile(rb"(?i)\b(?:password|passwd|contrasena|contrase\xc3\xb1a)\s*[:=]\s*"
                rb"[\"']?[^\s\"'<>{}$#\n]{6,}"), "MEDIA"),
    ("URL con credenciales", re.compile(rb"://[^/\s:@]+:[^/\s@]+@"), "ALTA"),
    ("cabecera Authorization", re.compile(rb"(?i)authorization:\s*(?:bearer|basic)\s+[A-Za-z0-9._\-+/=]{16,}"), "ALTA"),
]

# Rutas que no se escanean: binarios y la propia base regenerable.
IGNORA_SUF = {".png", ".jpg", ".jpeg", ".gif", ".pdf", ".docx", ".xlsx", ".pptx",
              ".zip", ".gz", ".pcap", ".db", ".joblib", ".pkl", ".svg", ".ico"}
IGNORA_DIR = {".git", "node_modules", "__pycache__", ".venv", "venv"}

# El propio escaner contiene los patrones que busca. Excluirlo por nombre seria
# fragil; se excluye por marca explicita en la linea.
MARCA = b"ppi-secrets:ignorar-linea"


def _util(nombres) -> list[Path]:
    return [Path(n) for n in sorted(nombres)
            if Path(n).is_file() and not IGNORA_DIR & set(Path(n).parts)
            and Path(n).suffix.lower() not in IGNORA_SUF]


def candidatos(todo: bool) -> list[Path]:
    if todo:
        # Dentro de un repositorio se escanea lo que git PUBLICA: lo rastreado mas
        # lo no rastreado que no este ignorado. Escanear tambien lo ignorado
        # inunda la salida con fixtures de dependencias vendorizadas, y un gate
        # que nadie lee no es un gate.
        r = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip() == "true":
            a = subprocess.run(["git", "ls-files"], capture_output=True, text=True)
            b = subprocess.run(["git", "ls-files", "--others", "--exclude-standard"],
                               capture_output=True, text=True)
            return _util(set(a.stdout.split()) | set(b.stdout.split()))
        return [p for p in Path(".").rglob("*")
                if p.is_file() and not IGNORA_DIR & set(p.parts)
                and p.suffix.lower() not in IGNORA_SUF]
    salida = subprocess.run(
        ["git", "diff", "--name-only", "--diff-filter=ACMR", "HEAD"],
        capture_output=True, text=True)
    extra = subprocess.run(
        ["git", "ls-files", "--others", "--exclude-standard"],
        capture_output=True, text=True)
    nombres = set(salida.stdout.split()) | set(extra.stdout.split())
    return [Path(n) for n in sorted(nombres)
            if Path(n).is_file() and Path(n).suffix.lower() not in IGNORA_SUF]


def revisa(p: Path) -> list[tuple[int, str, str, str]]:
    try:
        crudo = p.read_bytes()
    except OSError:
        return []
    if b"\0" in crudo[:8192]:          # binario
        return []
    hallazgos = []
    for n, linea in enumerate(crudo.splitlines(), 1):
        if MARCA in linea:
            continue
        for nombre, rx, sev in REGLAS:
            m = rx.search(linea)
            if m:
                frag = m.group()[:48].decode("utf-8", "replace")
                # nunca imprimir el secreto entero
                if sev == "ALTA" and len(frag) > 12:
                    frag = frag[:8] + "…" + frag[-3:]
                hallazgos.append((n, nombre, sev, frag))
    return hallazgos


HOOK = """#!/bin/sh
# instalado por ppi-secrets --hook
exec "$(git rev-parse --show-toplevel)/stack/bin/ppi-secrets"
"""


def main() -> int:
    ap = argparse.ArgumentParser(prog="ppi-secrets", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--todo", action="store_true", help="escanea el arbol completo")
    ap.add_argument("--hook", action="store_true", help="instala el pre-commit")
    a = ap.parse_args()

    if a.hook:
        raiz = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                              capture_output=True, text=True).stdout.strip()
        h = Path(raiz) / ".git" / "hooks" / "pre-commit"
        h.write_text(HOOK, encoding="utf-8")
        h.chmod(0o755)
        print(f"pre-commit instalado en {h}")
        return 0

    archivos = candidatos(a.todo)
    altas = medias = 0
    for p in archivos:
        for n, nombre, sev, frag in revisa(p):
            marca = "\033[31mALTA \033[0m" if sev == "ALTA" else "\033[33mMEDIA\033[0m"
            print(f"  {marca}  {p}:{n}  {nombre}  ->  {frag}")
            if sev == "ALTA":
                altas += 1
            else:
                medias += 1

    print(f"\n{len(archivos)} archivo(s) revisados · {altas} ALTA · {medias} MEDIA")
    if altas:
        print("\n\033[31mPublicacion bloqueada.\033[0m Quitar el secreto NO basta: "
              "si estuvo en un commit,\nsigue en el historial. Rotar la credencial.")
        return 1
    if medias:
        print("\033[33mRevisar los MEDIA a mano\033[0m: pueden ser ejemplos legitimos.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
