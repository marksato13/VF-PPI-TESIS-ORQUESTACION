#!/usr/bin/env bash
# Prueba de restauracion. El plan la exige explicitamente.
# Restaura el ultimo snapshot en un directorio temporal y compara hashes.
set -euo pipefail
raiz="$(cd "$(dirname "$0")/../.." && pwd)"
env_f="$raiz/stack/.env"
[ -f "$env_f" ] || { echo "Falta $env_f"; exit 2; }
# shellcheck disable=SC1090
set -a; . "$env_f"; set +a
command -v restic >/dev/null || { echo "Falta restic:  sudo stack/install.sh backup"; exit 3; }

destino="$(mktemp -d)"
trap 'rm -rf "$destino"' EXIT
echo "Restaurando el ultimo snapshot en $destino …"
restic restore latest --target "$destino"

n=0; malos=0
while IFS= read -r -d '' f; do
  orig="${f#$destino}"
  [ -f "$orig" ] || continue
  n=$((n+1))
  a="$(sha256sum "$f"    | cut -d' ' -f1)"
  b="$(sha256sum "$orig" | cut -d' ' -f1)"
  [ "$a" = "$b" ] || { echo "  DIFIERE  $orig"; malos=$((malos+1)); }
done < <(find "$destino" -type f -print0)

echo
echo "  $n archivo(s) comparados · $malos diferencia(s)"
if [ "$malos" -eq 0 ] && [ "$n" -gt 0 ]; then
  printf '\033[32m  Restauracion verificada.\033[0m\n'
else
  printf '\033[31m  Restauracion NO fiable.\033[0m\n'; exit 1
fi
