# Copiar a  stack/.env  y rellenar.  stack/.env NUNCA se versiona.
#
# Genera la contrasena, no la inventes:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"

POSTGRES_DB=ppi
POSTGRES_USER=ppi
POSTGRES_PASSWORD=

# ── copias (ppi-backup) ────────────────────────────────────────────────
# Disco externo, NAS o cualquier destino fuera de esta VM: si la VM muere,
# el backup dentro de la VM muere con ella.
RESTIC_REPOSITORY=/srv/ppi-evidence/backups/restic
RESTIC_PASSWORD_FILE=/home/m4rk/.config/ppi/restic.pass
PPI_BACKUP_RUTAS=/srv/ppi-evidence
